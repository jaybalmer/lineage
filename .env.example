# Linestry environment variables. Copy to .env.local and fill in real values.
# NEVER put real secrets in this file: it is committed to git.
#
# "required to boot" = the app fails or a core flow breaks without it.
# "degrades to no-op" = absent is silently tolerated (the feature just does
# nothing), which is exactly the class of drift this file exists to make visible.

# ── Supabase (required to boot) ──────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=            # required to boot
NEXT_PUBLIC_SUPABASE_ANON_KEY=       # required to boot
SUPABASE_SERVICE_ROLE_KEY=           # required to boot (all server DB writes)

# ── PostHog (analytics) ──────────────────────────────────────────────────────
# A MISSING NEXT_PUBLIC_POSTHOG_KEY SILENTLY DISABLES ALL CAPTURE on both the
# client and the server: every trackEvent / captureServerEvent becomes a no-op
# and the dashboards stay empty with no error anywhere.
NEXT_PUBLIC_POSTHOG_KEY=             # degrades to no-op (disables all capture)
NEXT_PUBLIC_POSTHOG_HOST=            # optional, defaults to https://us.i.posthog.com

# ── Sentry (error monitoring) ────────────────────────────────────────────────
NEXT_PUBLIC_SENTRY_DSN=              # degrades to no-op (no client/server error capture)
SENTRY_ORG=                         # build-time only (source maps upload)
SENTRY_PROJECT=                     # build-time only
SENTRY_AUTH_TOKEN=                  # build-time only

# ── Resend (transactional email) ─────────────────────────────────────────────
# Absent triggers the client-OTP fallback for magic links and skips every
# branded transactional send.
RESEND_API_KEY=                     # degrades to no-op / OTP fallback
ADMIN_NOTIFY_EMAIL=                 # optional, defaults to a hardcoded admin address

# ── Stripe (payments) ────────────────────────────────────────────────────────
# Absent secret/webhook keys make the checkout, portal, and webhook routes
# return 503; the price ids gate individual tiers.
STRIPE_SECRET_KEY=                  # required for any checkout
STRIPE_WEBHOOK_SECRET=              # required for the webhook to verify signatures
STRIPE_PRICE_ANNUAL=                # required for the annual tier
STRIPE_PRICE_LIFETIME=              # required for the lifetime tier
STRIPE_PRICE_FOUNDING=              # required for the founding tier
STRIPE_PRICE_GIFT_ANNUAL=           # required for gifting an annual membership

# ── Misc ─────────────────────────────────────────────────────────────────────
SERPER_API_KEY=                     # optional, used by catalog/research tooling
